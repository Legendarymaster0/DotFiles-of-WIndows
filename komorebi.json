{
  "$schema": "https://raw.githubusercontent.com/LGUG2Z/komorebi/v0.1.40/schema.json",
  "app_specific_configuration_path": "$Env:KOMOREBI_CONFIG_HOME/applications.json",
  "window_hiding_behaviour": "Hide",
  "cross_monitor_move_behaviour": "Insert",
  "default_workspace_padding": 14,
  "default_container_padding": 3,
  "stacking_enabled": true,
  "border": true,
  "border_width": 5,
  "border_offset": -1,
  "animation": {
    "enabled": true,
    "duration": 1000,
    "fps": 120,
    "style": "EaseOutQuart"
  },
  "theme": {
    "palette": "Catppuccin",
    "name": "Mocha",
    "focused_border": "Red",
    "unfocused_border": "Teal",
    "bar_accent": "Lavender",
    "single_border": "Red"
  },
  "monitors": [
    {
      "workspaces": [
        {
          "name": "I",
          "layout": "BSP"
        },
        {
          "name": "II",
          "layout": "VerticalStack"
        },
        {
          "name": "III",
          "layout": "HorizontalStack"
        },
        {
          "name": "IV",
          "layout": "UltrawideVerticalStack"
        },
        {
          "name": "V",
          "layout": "Rows"
        },
        {
          "name": "VI",
          "layout": "Grid"
        },
        {
          "name": "VII",
          "layout": "RightMainVerticalStack"
        }
      ]
    }
  ]
}
