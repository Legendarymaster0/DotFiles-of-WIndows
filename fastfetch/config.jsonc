{
  "$schema": "https://github.com/fastfetch-cli/fastfetch/raw/master/doc/json_schema.json",
  "logo": {
      "type": "file",
      "source": "~/.config/fastfetch/ascii.txt",
      "padding": { "left": 1, "right": 14 },
      "color": {
        "1": "#00d1ff"
      }
    },
  "modules": [
    {
      "type": "title",
      "format":"              Hyprland"
    },

{
  "type": "custom",
  "format": "╭─────────────────────────────────────────╮"
},
{ 
  "type": "os",     
  "key": "  OS",      
  "keyColor": "cyan", 
  "format": " Arch Linux" 
},
{ 
  "type": "kernel", 
  "key": "󰒔  Kernel",  
  "keyColor": "cyan",
  "format": "HYP_lmt 11.0.29700.2390"
},
{ 
  "type": "uptime", 
  "key": "󰔟  Uptime",  
  "keyColor": "cyan" 
},
{
  "type": "command",
  "key": "󰏗  packages",
  "keyColor": "cyan",
  "format": "Winget"
}, 
{
  "type": "custom",
  "format": "├─────────────────────────────────────────┤"
},
{ 
  "type": "wm",      
  "key": "󱂬  WindowManager",         
  "keyColor": "magenta", 
  "format": "hyprland" 
},
{ 
  "type": "terminal",
  "key": "󰆍  Terminal",   
  "keyColor": "magenta", 
  "format":"  Windows Terminal" 
},
{
  "type": "terminalfont",
  "key": "󰛖  Termfont",
  "keyColor": "magenta",
  "format": "JetBrainsMono Nerd Font"
}, 
{
  "type": "custom",
  "format": "├─────────────────────────────────────────┤"
},
{
  "type": "cpu",
  "key": "󰻟  Cpu",
  "keyColor": "#ffd0e1",
  "temp": true,
  "format": "{name} · {temperature}"
},
{
  "type": "gpu",
  "key": "󰾲  Gpu",
  "keyColor": "#ffd0e1",
  "temp": true,
  "format": "{name} · {temperature}"
},
{ "type": "memory", 
  "key": "󰍛  Ram",    
  "keyColor": "#ffd0e1" 
},
{ 
  "type": "swap",   
  "key": "󱘶  Swap",   
  "keyColor": "#ffd0e1" 
},
{ "type": "Disk", 
  "key": "󰋊  Disk 1", 
  "keyColor": "#ffd0e1", 
  "format": "{size-used} / {size-total} "
},
{ "type": "Disk", 
  "key": "󰋊  Disk 2", 
  "keyColor": "#ffd0e1",
  "format": "{name} "
},
{
  "type": "custom",
  "format": "├─────────────────────────────────────────┤"
},
{
  "type": "custom",
  "key": "󱥚  Palette",
  "keyColor": "#00d1ff",
  "format": "󰮯 \u001b[31m󰮯 \u001b[32m󰮯 \u001b[33m󰮯 \u001b[34m󰮯 \u001b[35m󰮯 \u001b[36m󰮯 \u001b[38;2;82;173;255m󰮯 \u001b[38;2;245;224;220m󰮯             │"
},
{
  "type": "custom",
  "format": "╰─────────────────────────────────────────╯"
   }
  ]
}
