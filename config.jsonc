    "type": "file",
    "source": "~/.config/fastfetch/ascii.txt",
    "padding": { "left": 0, "right": 2 },
    "color": {
    "1": "#7AA2F7",
    "2": "#f5e0dc"
    }
  },
  "modules": [
    {
      "type": "custom",
      "format": "  \u001b[38;2;122;162;247m\ue0b6\u001b[48;2;122;162;247m\u001b[38;2;26;27;38m  SYSTEM \u001b[0m\u001b[38;2;122;162;247m\ue0b4\u001b[0m\n"
    },
    {
      "type": "os",
      "key": " ",
      "format": "  \u001b[38;2;127;183;255m\ue0b6\u001b[48;2;127;183;255m\u001b[38;2;26;27;38m OS \u001b[48;2;180;190;254m\u001b[38;2;127;183;255m\ue0b4\u001b[38;2;21;21;32m Arch Linux \u001b[0m\u001b[38;2;180;190;254m\ue0b4\u001b[0m"
    },
