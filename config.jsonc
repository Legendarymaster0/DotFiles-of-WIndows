      "key": " ",
      "format": "  \u001b[38;2;127;183;255m\ue0b6\u001b[48;2;127;183;255m\u001b[38;2;26;27;38m UP \u001b[48;2;180;190;254m\u001b[38;2;127;183;255m\ue0b4\u001b[38;2;21;21;32m {?days}{days}d {?}{?hours}{hours}h {?}{minutes}m \u001b[0m\u001b[38;2;180;190;254m\ue0b4\u001b[0m\n"
    },
    {
      "type": "custom",
      "format": " ────────────────────────────────────────────────────────────────────────────────\n"
